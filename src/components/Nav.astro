---
const links = [
  { href: '/schools', label: 'AI Safety' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/about', label: 'About' },
];
const currentPath = Astro.url.pathname;
---
<nav class="site-nav" aria-label="Primary navigation">
  <a href="/" class="brand-link">
    <svg class="brand-mark" width="26" height="26" viewBox="0 0 28 28" fill="none" aria-hidden="true">
      <circle cx="14" cy="14" r="12.5" stroke="#C4942A" stroke-width="0.75" fill="none"/>
      <circle cx="14" cy="14" r="8" stroke="rgba(196,148,42,0.3)" stroke-width="0.5" fill="none"/>
      <line x1="14" y1="1.5" x2="14" y2="26.5" stroke="rgba(196,148,42,0.5)" stroke-width="0.75"/>
      <line x1="1.5" y1="14" x2="26.5" y2="14" stroke="rgba(196,148,42,0.5)" stroke-width="0.75"/>
      <line x1="5" y1="5" x2="23" y2="23" stroke="rgba(196,148,42,0.25)" stroke-width="0.5"/>
      <line x1="23" y1="5" x2="5" y2="23" stroke="rgba(196,148,42,0.25)" stroke-width="0.5"/>
      <polygon points="14,2.5 15.2,12.5 14,11.5 12.8,12.5" fill="#C4942A"/>
      <polygon points="14,25.5 12.8,15.5 14,16.5 15.2,15.5" fill="rgba(196,148,42,0.4)"/>
      <circle cx="14" cy="14" r="2" fill="#C4942A"/>
    </svg>
    <span class="brand-name">Windrose <span>&amp;</span> Company</span>
  </a>

  <div class="desktop-links">
    {links.map(({ href, label }) => (
      <a href={href} class={currentPath === href ? 'nav-link active' : 'nav-link'}>{label}</a>
    ))}
    <a href="/contact" class={currentPath === '/contact' ? 'contact-link active' : 'contact-link'}>Get in touch</a>
  </div>

  <details class="mobile-nav">
    <summary aria-label="Open navigation menu">
      <span class="sr-only">Menu</span>
      <span class="menu-lines" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </summary>
    <div class="mobile-panel">
      {links.map(({ href, label }) => (
        <a href={href} class={currentPath === href ? 'mobile-link active' : 'mobile-link'}>{label}</a>
      ))}
      <a href="/contact" class={currentPath === '/contact' ? 'mobile-contact active' : 'mobile-contact'}>Get in touch</a>
    </div>
  </details>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    height: 64px;
    padding: 0 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(6, 16, 30, 0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(196, 148, 42, 0.15);
  }

  .brand-link {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-mark { flex: 0 0 auto; }

  .brand-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    font-weight: 500;
    color: #F4EFE6;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .brand-name span { color: #C4942A; }

  .desktop-links {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .nav-link,
  .contact-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nav-link { color: rgba(244, 239, 230, 0.55); }
  .nav-link.active { color: #F4EFE6; }

  .contact-link {
    font-weight: 500;
    color: #C4942A;
    border: 1px solid rgba(196, 148, 42, 0.55);
    padding: 7px 18px;
  }

  .contact-link.active {
    color: #F4EFE6;
    border-color: rgba(244, 239, 230, 0.45);
  }

  .mobile-nav { display: none; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 800px) {
    .site-nav { padding: 0 20px; }
    .desktop-links { display: none; }

    .mobile-nav {
      display: block;
      position: relative;
      flex: 0 0 auto;
      margin-left: 16px;
    }

    .mobile-nav summary {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      cursor: pointer;
      list-style: none;
      border: 1px solid rgba(196, 148, 42, 0.28);
      background: rgba(196, 148, 42, 0.04);
    }

    .mobile-nav summary::-webkit-details-marker { display: none; }

    .menu-lines {
      width: 18px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .menu-lines span {
      display: block;
      width: 100%;
      height: 1px;
      background: #C4942A;
      transition: transform 160ms ease, opacity 160ms ease;
    }

    .mobile-nav[open] .menu-lines span:nth-child(1) { transform: translateY(5px) rotate(45deg); }
    .mobile-nav[open] .menu-lines span:nth-child(2) { opacity: 0; }
    .mobile-nav[open] .menu-lines span:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

    .mobile-panel {
      position: absolute;
      top: 50px;
      right: 0;
      width: min(260px, calc(100vw - 40px));
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      background: #081423;
      border: 1px solid rgba(196, 148, 42, 0.24);
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
    }

    .mobile-link,
    .mobile-contact {
      min-height: 44px;
      display: flex;
      align-items: center;
      padding: 10px 12px;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .mobile-link { color: rgba(244, 239, 230, 0.7); }
    .mobile-link.active { color: #F4EFE6; background: rgba(244, 239, 230, 0.04); }

    .mobile-contact {
      margin-top: 6px;
      justify-content: center;
      color: #C4942A;
      border: 1px solid rgba(196, 148, 42, 0.5);
    }

    .mobile-contact.active { color: #F4EFE6; }
  }

  @media (max-width: 480px) {
    .site-nav { padding: 0 16px; }
    .brand-mark { width: 24px; height: 24px; }
    .brand-name { font-size: 16px; }
    .mobile-nav { margin-left: 10px; }
    .mobile-panel { width: min(260px, calc(100vw - 32px)); }
  }

  @media (max-width: 350px) {
    .brand-name { font-size: 15px; letter-spacing: 0; }
    .brand-mark { width: 22px; height: 22px; }
  }
</style>
